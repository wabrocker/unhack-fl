# Cache policy. Paired with the content-hashed asset URLs that build.sh
# stamps into index.html.
#
# The rule: HTML is never cached, hashed assets are cached forever. A new
# deploy changes the hash, so browsers and the CDN fetch the new file
# because it is a different URL — no purge required.

<IfModule mod_headers.c>
  # index.html must always be revalidated, or nobody ever sees the new
  # asset URLs and the hashing accomplishes nothing.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Safe to cache hard: these URLs carry a hash of their own contents.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # County data is not hashed and does change. A day-long max-age meant a
  # deploy could sit invisible at the CDN edge for up to 24h with no way
  # to force it short of a manual purge — hit exactly that 2026-08-06
  # shipping the ERM request_url. Five minutes bounds that window without
  # losing meaningful caching benefit for a low-traffic site.
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

# Never serve dotfiles, whatever ends up here.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

Options -Indexes
